{
  "name": "git-issue-agent",
  "version": "1.0.0",
  "description": "GitHub 이슈를 자동으로 분석하고 수정하는 에이전트",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "git-issue-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github",
    "issues",
    "automation",
    "claude",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "commander": "^11.0.0",
    "dotenv": "^16.0.0",
    "node-html-to-image": "^4.0.0",
    "chalk": "^5.0.0",
    "ora": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
